<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Abstractions of graphs to be examined and manipulated in a data-structure agnostic fashion.
Commonly used types:
• IHeadIncidence&lt;TVertex, TEdge&gt;
• IOutEdgesIncidence&lt;TVertex, TEdges&gt;
• IOutNeighborsAdjacency&lt;TVertex, TNeighbors&gt;
• IMonoid&lt;T&gt;</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>abstraction;graph</PackageTags>
    <Title>Graph abstractions</Title>
    <VersionSuffix>preview</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>0.17</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <TargetFrameworks>net462;netstandard2.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DebugType)' == 'portable'">
    <EmbedAllSources>true</EmbedAllSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Import Condition="'$(TargetFramework)' == 'net462' OR '$(TargetFramework)' == 'netstandard2.0'" Project="..\Shared\NullableAttributes\NullableAttributes.projitems" Label="Shared" />

</Project>
